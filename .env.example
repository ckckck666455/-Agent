# ===== DeepSeek =====
# 推荐模式：auto。有 Key 走 DeepSeek，没有 Key 自动离线规则引擎。
LLM_MODE=auto
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_FALLBACK_MODEL=deepseek-chat
LLM_TEMPERATURE=0.4
LLM_MAX_TOKENS=700
LLM_TIMEOUT=50

# ===== Agent 行为 =====
MAX_TOOL_ROUNDS=4
MAX_TOOL_CALLS=6
MAX_REPLY_CHARS=480
HISTORY_TOKEN_BUDGET=3000
MAX_RECENT_MESSAGES=24
SUMMARY_TRIGGER_TOKENS=3800
SUMMARY_KEEP_MESSAGES=8
RATE_LIMIT_PER_MINUTE=40

# ===== 业务规则 =====
COUPON_MAX_AMOUNT=20
RETENTION_COUPON_LIMIT=1
RETURN_WINDOW_DAYS=7

# ===== 演示 =====
# 演示数据的时间锚点；不填则使用系统真实时间。
# 如果你在 2026-11 之后演示退货场景，可改成数据对应日期。
DEMO_NOW=2026-11-04 14:00
LOG_LEVEL=INFO
